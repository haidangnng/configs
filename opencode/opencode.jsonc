{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/claude-sonnet-4.5",
  "small_model": "github-copilot/claude-haiku-4.5",
  "autoupdate": true,
  "theme": "ayu",
  "tui": {
    "scroll_acceleration": {
      "enabled": true
    }
  },
  "share": "disabled",
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "webfetch": "ask",
    "doom_loop": "ask",
    "external_directory": "deny"
  },
  "tools": {
    "edit": true,
    "bash": true,
    "write": true,
  },
  "instructions": [
    "CONTRIBUTING.md",
    "docs/guidelines.md",
    "CLAUDE.md"
  ],
}
