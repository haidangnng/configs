{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/claude-opus-4.5",
  "small_model": "github-copilot/claude-haiku-4.5",
  "autoupdate": false,
  "theme": "transparent",
  "tui": {
    "scroll_acceleration": {
      "enabled": true
    }
  },
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "webfetch": "ask", // Global setting, overridden per agent below
    "doom_loop": "ask",
    "external_directory": "deny"
  },
  "tools": {
    "edit": true,
    "bash": true,
    "write": true
  },
  "instructions": [
    "CONTRIBUTING.md",
    "docs/guidelines.md",
    "CLAUDE.md",
    "AGENTS.md"
  ],
}
