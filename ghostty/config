# Ported from ~/.config/wezterm

# FONT
font-family = Monaspace Neon
font-size = 14
font-style-italic = Light Italic
adjust-cell-height = 30%

# COLORS
theme = Jellybeans
bold-color = bright

# WINDOW
window-padding-x = 8
window-padding-y = 0
background-opacity = 0.9
background-blur = 10
macos-titlebar-style = tabs
unfocused-split-opacity = 0.9
maximize = true

# Install Ghostty's terminfo on ssh hosts (TERM=xterm-ghostty)
shell-integration-features = ssh-env,ssh-terminfo

# KEYS
# Pass cmd+m through instead of minimizing
keybind = cmd+m=unbind
# Option+arrows jump by word
keybind = alt+left=esc:b
keybind = alt+right=esc:f
keybind = ctrl+shift+u=scroll_page_fractional:-0.5
keybind = ctrl+shift+d=scroll_page_fractional:0.5

# TABS (leader = ctrl+a)
keybind = ctrl+a>l=next_tab
keybind = ctrl+a>h=previous_tab
keybind = ctrl+a>e=prompt_tab_title
keybind = ctrl+1=goto_tab:1
keybind = ctrl+2=goto_tab:2
keybind = ctrl+3=goto_tab:3
keybind = ctrl+4=goto_tab:4
keybind = ctrl+5=goto_tab:5
keybind = ctrl+6=goto_tab:6
keybind = ctrl+7=goto_tab:7
keybind = ctrl+8=goto_tab:8
keybind = ctrl+9=goto_tab:9

# SPLITS
keybind = ctrl+a>|=new_split:right
keybind = ctrl+a>-=new_split:down
keybind = ctrl+a>w=close_surface
keybind = ctrl+a>m=toggle_split_zoom
keybind = ctrl+a>ctrl+h=goto_split:left
keybind = ctrl+a>ctrl+j=goto_split:down
keybind = ctrl+a>ctrl+k=goto_split:up
keybind = ctrl+a>ctrl+l=goto_split:right

# Resize mode: ctrl+a r, then hjkl, q/esc to leave
keybind = ctrl+a>r=activate_key_table:resize_pane
keybind = resize_pane/h=resize_split:left,40
keybind = resize_pane/j=resize_split:down,40
keybind = resize_pane/k=resize_split:up,40
keybind = resize_pane/l=resize_split:right,40
keybind = resize_pane/q=deactivate_key_table
keybind = resize_pane/escape=deactivate_key_table
