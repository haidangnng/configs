{
  "$schema": "https://opencode.ai/config.json",
  // Default model configuration
  "model": "github-copilot/claude-sonnet-4.5",
  "small_model": "github-copilot/claude-haiku-4.5",
  // Auto-update settings
  "autoupdate": true,
  // Theme configuration (uncomment and change to customize)
  "theme": "ayu",
  // TUI settings for better scrolling experience
  "tui": {
    "scroll_acceleration": {
      "enabled": true
    }
  },
  // Share settings (manual by default)
  "share": "disabled",
  // Tool permissions (uncomment to require approval for specific tools)
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "webfetch": "ask",
    "doom_loop": "ask",
    "external_directory": "deny"
  },
  "tools": {
    "edit": false,
    "bash": false,
    "write": false,
  },
  // Custom instructions (add paths to instruction files)
  "instructions": [
    "CONTRIBUTING.md",
    "docs/guidelines.md",
    "CLAUDE.md"
  ],
  // Code formatter configuration
  // "formatter": {
  //   "prettier": {
  //     "disabled": false
  //   }
  // }
}
