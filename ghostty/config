# Ported from ~/.config/wezterm

# FONT
font-family = Monaspace Neon
font-size = 14
font-style-italic = Light Italic
adjust-cell-height = 30%

# COLORS
theme = vscode-dark-2026
bold-color = bright

# WINDOW
window-padding-x = 5
window-padding-y = 0
window-padding-balance = true
window-padding-color = extend
# Solid like VS Code (was 0.9 opacity + blur)
background-opacity = 1
# tmux draws tabs/status, so no native titlebar or tab bar
macos-titlebar-style = hidden
window-colorspace = display-p3
maximize = true

# CURSOR / MOUSE
cursor-style = bar
cursor-style-blink = true
adjust-cursor-thickness = 2
mouse-hide-while-typing = true

# Install Ghostty's terminfo on ssh hosts (TERM=xterm-ghostty)
shell-integration-features = ssh-env,ssh-terminfo

# Every window starts in (or reattaches to) the tmux session "main";
# tabs, splits and workspaces live in tmux (~/.config/tmux/tmux.conf)
command = /opt/homebrew/bin/tmux new-session -A -s main

# KEYS
# Pass cmd+m through instead of minimizing
keybind = cmd+m=unbind
# Option+arrows jump by word
keybind = alt+left=esc:b
keybind = alt+right=esc:f
keybind = ctrl+shift+u=scroll_page_fractional:-0.5
keybind = ctrl+shift+d=scroll_page_fractional:0.5

# TMUX (leader = ctrl+a, handled by tmux)
# ctrl+1..9 and cmd+t send "leader <key>" so tmux switches/creates windows
keybind = ctrl+1=text:\x011
keybind = ctrl+2=text:\x012
keybind = ctrl+3=text:\x013
keybind = ctrl+4=text:\x014
keybind = ctrl+5=text:\x015
keybind = ctrl+6=text:\x016
keybind = ctrl+7=text:\x017
keybind = ctrl+8=text:\x018
keybind = ctrl+9=text:\x019
keybind = cmd+t=text:\x01t
# Ghostty's own splits are unused; drop cmd+d / cmd+shift+d
keybind = super+d=unbind
keybind = super+shift+d=unbind
